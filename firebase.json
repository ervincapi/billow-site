{
  "hosting": {
    "site": "billow-513813",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "tools/**",
      "**/.*",
      "**/node_modules/**",
      "README.md"
    ],
    "cleanUrls": false,
    "trailingSlash": true,
    "headers": [
      {
        "source": "**/*.@(jpg|png|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "/img/og-*.png",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/billow-site/:path*",
        "destination": "/:path",
        "type": 301
      },
      {
        "source": "/guides/cancel-netflix{,/**}",
        "destination": "/guides/how-to-cancel-a-subscription/",
        "type": 301
      },
      {
        "source": "/de/guides/cancel-netflix{,/**}",
        "destination": "/de/guides/how-to-cancel-a-subscription/",
        "type": 301
      },
      {
        "source": "/es/guides/cancel-netflix{,/**}",
        "destination": "/es/guides/how-to-cancel-a-subscription/",
        "type": 301
      },
      {
        "source": "/it/guides/cancel-netflix{,/**}",
        "destination": "/it/guides/how-to-cancel-a-subscription/",
        "type": 301
      },
      {
        "source": "/sq/guides/cancel-netflix{,/**}",
        "destination": "/sq/guides/how-to-cancel-a-subscription/",
        "type": 301
      }
    ]
  }
}
